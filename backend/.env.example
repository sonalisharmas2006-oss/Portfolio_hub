# Copy to .env and replace values. Never commit .env.
APP_ENV=development
APP_NAME=Sonali Sharma Portfolio API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./portfolio.db
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=sonali
# Set a strong password before first run. There is no default admin password.
ADMIN_PASSWORD=
SESSION_MAX_AGE_SECONDS=28800
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://portfolio-hub-psi-beige.vercel.app
MAX_UPLOAD_MB=12
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8000

# Storage: use "local" only for development. Production requires Supabase Storage.
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio-uploads
RESEND_API_KEY=
CONTACT_TO_EMAIL=sonalisharma.s2006@gmail.com
RESEND_FROM_EMAIL=
